POSTGRES_USER=exchange
POSTGRES_PASSWORD=exchange
POSTGRES_DB=exchange

EXCHANGE_DATABASE_URL=postgresql+asyncpg://exchange:exchange@db:5432/exchange
EXCHANGE_MONITORED_PAIRS=BRL-USD,BRL-EUR,BRL-ARS,BRL-UYU,USD-BRL,USD-EUR,USD-ARS,USD-UYU
EXCHANGE_POLLING_INTERVAL_SECONDS=30
EXCHANGE_AWESOMEAPI_BASE_URL=https://economia.awesomeapi.com.br
EXCHANGE_PROVIDER_TIMEOUT_SECONDS=5
EXCHANGE_PROVIDER_RETRY_ATTEMPTS=4
EXCHANGE_LOG_LEVEL=INFO
EXCHANGE_LOG_JSON=true
EXCHANGE_CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:8080"]
EXCHANGE_ENVIRONMENT=development

VITE_API_BASE_URL=http://localhost:8000

# Airflow (LocalExecutor) — orchestrates polling (replaces the APScheduler worker)
# Airflow UI: http://localhost:8081  (login admin / admin)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
